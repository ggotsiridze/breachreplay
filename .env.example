# Copy to .env to override defaults. Never commit .env.

# Published ports (bound to 127.0.0.1)
WEB_PORT=8080
API_PORT=8000

# Upload limit for captures (MB)
MAX_UPLOAD_MB=50

# Mask internal IPs and restrict evidence detail in API responses
PUBLIC_MODE=false

# Per-tool analysis timeout (seconds)
ANALYZER_TIMEOUT_SECONDS=180

# Base images (override to use a registry mirror, e.g. mirror.gcr.io/library/python:3.12-slim)
#ZEEK_IMAGE=zeek/zeek:7.0.5
#SURICATA_IMAGE=jasonish/suricata:7.0.10
#PYTHON_IMAGE=python:3.12-slim
#NODE_IMAGE=node:22-alpine
#NGINX_IMAGE=nginx:1.27-alpine

# Optional: PEM bundle for a TLS-inspecting proxy, used only during image builds
#EXTRA_CA_CERT=/path/to/ca-bundle.pem
